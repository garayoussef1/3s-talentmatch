# Base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/talentmatch

# API
API_HOST=0.0.0.0
API_PORT=8000

# Auth — JWT
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP — Gmail (pour vérification email et reset mot de passe)
# ⚠️  Utilisez un "App Password" Gmail, pas votre vrai mot de passe !
# → https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=garayoussef0@gmail.com
SMTP_PASSWORD=votre-app-password-ici
SMTP_FROM_NAME=3S TalentMatch

# OAuth Google
# → https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth LinkedIn
# → https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── NLP : spaCy (moteur principal) ──────────────────────────────────────────
# spaCy fr_core_news_md est le moteur NLP principal (NER, extraction nom, entités).
# Aucune configuration requise — fonctionne 100% local, sans internet.

# ── CamemBERT / HuggingFace (enrichissement optionnel — désactivé par défaut) ──
# CamemBERT est un enrichissement optionnel qui améliore l'extraction du nom.
# Désactivé par défaut : spaCy seul est suffisant pour l'extraction complète.
#
# Pour activer :
#   1. Créez un token HuggingFace sur https://huggingface.co/settings/tokens
#   2. Décommentez les lignes ci-dessous
#   3. Mettez HF_ENABLE_CAMEMBERT_NAME=1

# --- CamemBERT (HuggingFace Inference API) — OPTIONNEL / EXPÉRIMENTAL ---
# Remarque encadrante: dépendance externe (quotas/latence/confidentialité).
# => Désactivé par défaut. Pour l'activer explicitement:
# HF_ENABLE_CAMEMBERT_NAME=1
# HF_TOKEN=hf_xxx

# HF_ENABLE_CAMEMBERT_NAME=0
# HF_TOKEN=
# HF_CAMEMBERT_NER_MODEL=Jean-Baptiste/camembert-ner
# HF_TIMEOUT_SECONDS=5
#
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_ENABLE_CAMEMBERT_NAME=0    # 0=désactivé (défaut), 1=activé
# HF_CAMEMBERT_NER_MODEL=Jean-Baptiste/camembert-ner
# HF_TIMEOUT_SECONDS=5
