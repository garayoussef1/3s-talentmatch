# Frontend (Vite)
# Copiez ce fichier en `.env` (ou `.env.local`) puis redémarrez `npm run dev`.

# Google OAuth Client ID (PUBLIC)
# Créez un client OAuth "Web application" dans Google Cloud Console.
# Authorized redirect URI (dev): http://localhost:3000/auth/callback/google
VITE_GOOGLE_CLIENT_ID=

# LinkedIn OAuth Client ID (PUBLIC)
# Authorized redirect URI (dev): http://localhost:3000/auth/callback/linkedin
VITE_LINKEDIN_CLIENT_ID=
