@startuml diagramme_sequence
skinparam shadowing true
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequence {
  ArrowColor #1b4f8a
  ActorBorderColor #1b4f8a
  ActorBackgroundColor White
  ActorFontColor #1b4f8a
  LifeLineBorderColor #1b4f8a
  LifeLineBackgroundColor #f0f4ff
  ParticipantBorderColor #1b4f8a
  ParticipantBackgroundColor #f0f4ff
  ParticipantFontColor #1b4f8a
  GroupBorderColor #888888
  GroupBackgroundColor #f8f8f8
  DividerBorderColor #1b4f8a
  DividerBackgroundColor #d6e4f7
  DividerFontColor #1b4f8a
}
skinparam database {
  BackgroundColor #f0f4ff
  BorderColor #1b4f8a
}

actor "Candidat" as C
actor "Recruteur" as R
participant "Interface Web\n(React)" as F
participant "Serveur API\n(FastAPI)" as A
participant "Module\nd'extraction" as E
participant "Analyseur\nNLP (spaCy)" as N
participant "Moteur de\nmatching" as M
database "Base de\ndonnées" as DB

== 1. Téléversement et extraction du CV ==

C -> F : Sélectionne un fichier CV\n(PDF, DOCX ou image)
activate F
F -> A : Envoi du fichier CV
activate A
A -> E : Extraction du texte
activate E
E -> E : Détection du format\net extraction du contenu
E --> A : Texte extrait
deactivate E

A -> N : Analyse du texte
activate N
N -> N : Extraction des informations :\ncontact, compétences,\nformation, expérience
N --> A : Profil structuré (JSON)
deactivate N

A -> DB : Enregistrement du profil candidat
DB --> A : Confirmation
A --> F : Profil extrait avec succès
deactivate A
F --> C : Affichage du profil extrait
deactivate F

== 2. Lancement du matching (Recruteur) ==

R -> F : Sélectionne une offre\net lance le matching
activate F
F -> A : Demande de matching
activate A
A -> DB : Récupération des candidats\net de l'offre
DB --> A : Données candidats + offre
A -> M : Calcul des scores
activate M
M -> M : Score sémantique + compétences\n+ expérience + formation
M --> A : Scores et explications
deactivate M
A -> DB : Sauvegarde des résultats
A --> F : Classement des candidats
deactivate A
F --> R : Résultats triés avec\nexplication des scores
deactivate F

@enduml
